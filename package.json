{
  "name": "pi-recollect",
  "version": "2.0.1",
  "description": "Silent background cross-session memory for Pi: learns from finished sessions, injects a compact memory index, and lets the agent grep deeper memory on demand.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/TunkShif/pi-recollect#readme",
  "repository": { "type": "git", "url": "git+https://github.com/TunkShif/pi-recollect.git" },
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory"
  ],
  "files": [
    "src",
    "prompts",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
